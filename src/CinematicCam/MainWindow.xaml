<Window x:Class="CinematicCam.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CinematicCam — MSFS 2024" Width="1300" Height="900" MinWidth="1100" MinHeight="640"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <DockPanel Background="{StaticResource Bg}">
        <!-- Üst bar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBg}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="24,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,28,0">
                    <Path Data="M4 6h11a1.5 1.5 0 0 1 1.5 1.5v9A1.5 1.5 0 0 1 15 18H4a1.5 1.5 0 0 1-1.5-1.5v-9A1.5 1.5 0 0 1 4 6z M16.5 10.5l5-3v9l-5-3"
                          Stroke="{StaticResource Accent}" StrokeThickness="1.8" StrokeLineJoin="Round" Width="26" Height="26" Stretch="Uniform" />
                    <TextBlock Text="CinematicCam" FontSize="17" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel x:Name="RightBar" Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Border x:Name="ConnPill" CornerRadius="999" Padding="12,6" Margin="0,0,8,0" Background="{StaticResource WarnSoft}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ConnDot" Width="8" Height="8" Fill="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock x:Name="ConnText" Text="MSFS bekleniyor…" FontSize="13" Foreground="{StaticResource AccentText}" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="AircraftPill" CornerRadius="999" Padding="12,6" Margin="0,0,12,0" Background="{StaticResource Raised}" Visibility="Collapsed">
                        <TextBlock x:Name="AircraftText" FontSize="13" />
                    </Border>
                    <Button x:Name="ToggleButton" Click="Toggle_Click" MinHeight="44" Padding="20,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ToggleDot" Width="10" Height="10" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="ToggleText" Text="Kamerayı Aç" FontSize="15" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel x:Name="Nav" Orientation="Horizontal" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Telemetri -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource HeaderBg}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,9">
            <TextBlock x:Name="TelemetryText" FontFamily="{StaticResource MonoFont}" FontSize="12.5" Foreground="{StaticResource FgDim}" TextWrapping="Wrap" />
        </Border>

        <ContentControl x:Name="PageHost" Margin="24,20,24,20" Focusable="False" />
    </DockPanel>
</Window>
